# Sandbox — тестове середовище. Скопіюйте цей файл у .env.sandbox (він у .gitignore).
APP_ENV=sandbox
DEBUG=true
ENABLE_DOCS=true

# Ключ підпису JWT (тільки для sandbox, мінімум 32 символи)
SECRET_KEY=sandbox-only-secret-key-not-for-production-0123456789

# Окрема база даних sandbox
POSTGRES_USER=sandbox_user
POSTGRES_PASSWORD=sandbox_pass
POSTGRES_DB=booking_sandbox
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Порти на вашому комп'ютері (production використовує інші, щоб працювати паралельно)
APP_PORT=8000
REDIS_PORT=6379

# У sandbox в образ ставимо і dev-залежності (pytest, лінтери)
REQUIREMENTS=requirements-dev.txt
