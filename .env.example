ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://booking_user:booking_pass@localhost:5432/booking_db
REDIS_URL=redis://localhost:6379/0
BOOKING_LOCK_TTL_SECONDS=10

# JWT-автентифікація. В продакшн SECRET_KEY обов'язково має бути
# випадковим і триматись у секреті (не в git!). Для локальної розробки
# значення за замовчуванням підходить.
SECRET_KEY=change-me-in-production-this-is-a-lab-default-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
