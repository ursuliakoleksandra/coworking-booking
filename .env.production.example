# Production — робоче середовище. Скопіюйте цей файл у .env.production (він у .gitignore)
# і замініть усі значення CHANGE-ME на власні. Реальні секрети НІКОЛИ не комітьте.
APP_ENV=production
DEBUG=false
ENABLE_DOCS=false

# Згенеруйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-generate-with-secrets-token-urlsafe-48

# Окрема база даних production
POSTGRES_USER=booking_prod_user
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=booking_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

REDIS_URL=redis://localhost:6380/0

APP_PORT=8001
REDIS_PORT=6380

# У production — лише робочі залежності
REQUIREMENTS=requirements.txt
